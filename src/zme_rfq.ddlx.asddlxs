@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'RFQ Comparison',
    typeNamePlural: 'RFQ Comparisons',
    title: {
      type: #STANDARD,
      value: 'rfq'
    }
  }
}
@UI.deleteHidden: true
//annotate view ZCDS_C_RFQ with
annotate entity Zcds_rfq_ce
    with
{
   @UI.facet: [
    {
      id: 'General',
      label: 'General Information',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'GENERAL',
      position: 10
    },
    {
            id: 'ComparisonHeader',
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            label: 'Create Comparison',
            position: 10,
            targetQualifier: 'Header'
      },
    
    {
      id: 'Quotation1',
      label: 'Quotation 1',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Q1',
      position: 20
