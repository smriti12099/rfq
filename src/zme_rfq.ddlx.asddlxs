      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Q4',
      position: 50
    }
  ]
  
  
  
    // =========================================================
    // HEADER FIELDS
    // =========================================================
  @EndUserText.label: 'RFQ Number'  
 @UI.selectionField: [{ position: 1 }]
  @UI.lineItem: [{ position: 1 }]
    @UI.fieldGroup: [
        {
            qualifier: 'Header',
            position: 10
        }
    ]
    rfq;

  @EndUserText.label: 'Procurement Type'  
    @UI.fieldGroup: [
        {
            qualifier: 'Header',
            position: 20
        }
